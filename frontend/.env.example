# FOODLINK AI - Environment Variables Example
# Note: Do not store actual production secrets or API keys in this file.

# Google Gemini API Key (Server-Side only via server.js)
GEMINI_API_KEY=

# Server Port (Default is 3000)
PORT=3000

# Client API Base URL (Default is /api for Vite reverse proxy)
VITE_API_BASE_URL=/api

# Optional: Set to 'true' to force client mock data mode for offline development
VITE_USE_MOCK_API=false
